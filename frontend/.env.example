# API 주소. 로컬 실행 시 백엔드는 SERVER_PORT=8090 (compose 앱은 APP_PORT=8091)
VITE_API_BASE_URL=http://localhost:8090
# 배포(Vercel, docs/operations.md 8장): VITE_API_BASE_URL을 빈 값으로 → 같은 출처 /api (vercel.json rewrite가 백엔드로 프록시)
# VITE_API_BASE_URL=
# 사장님 실시간 알림(SSE)만 API 주소로 직접 연결할 때 (선택, 비우면 VITE_API_BASE_URL과 같음)
# VITE_STREAM_BASE_URL=https://api.example.com

# 로그인 화면 "테스트 계정으로 채우기" (선택, 로컬 데모용). 역할:아이디:비밀번호를 쉼표로 — 운영 빌드에는 넣지 않음
