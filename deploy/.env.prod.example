# 운영 배포 환경변수 (#86) — 복사해서 deploy/.env.prod로 저장 후 값 입력 (deploy/.env.prod는 커밋 금지, .gitignore)
# 사용: docker compose -f deploy/compose.prod.yml --env-file deploy/.env.prod up -d --build

# API 도메인 (Caddy가 이 이름으로 인증서 발급). 도메인이 없으면 VM 공인 IP로 sslip.io 사용: 158.180.1.2 → 158-180-1-2.sslip.io
API_DOMAIN=
# 프론트(Vercel) 주소 — 끝 슬래시 없이. CORS·소셜 로그인 콜백에 사용
FRONTEND_ORIGIN=https://

# DB 계정 (처음 기동할 때 이 값으로 생성됨 — 이후 바꾸려면 DB에서 직접 변경)
DB_USERNAME=delivery
DB_PASSWORD=
# Base64 256비트 이상. 생성: openssl rand -base64 32 (로컬 .env와 다른 값)
JWT_SECRET=

# 선택 — 비우면 해당 기능 꺼짐
NOTIFICATION_SENDER=log
SLACK_WEBHOOK_URL=
# 토스페이먼츠 test_ 키만 (비우면 모의 결제)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 소셜 로그인 — 콘솔에 Redirect URI 등록: {FRONTEND_ORIGIN}/login/oauth2/code/kakao · /google
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# --profile monitoring일 때 필수 (빈 값·admin 불가)
GRAFANA_ADMIN_PASSWORD=
