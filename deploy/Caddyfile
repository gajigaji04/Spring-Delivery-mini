# Caddy — API 도메인 HTTPS 종료 후 앱(app:8080)으로 전달 (#86, docs/operations.md 8장)
# 인증서는 Let's Encrypt 자동 발급·갱신 (VM 보안 목록·방화벽에서 80·443 열려 있어야 함)
{$API_DOMAIN} {
	# SSE(text/event-stream)는 Caddy가 응답 형식을 보고 바로바로 내보냄(버퍼링 없음) → 별도 설정 불필요
	# encode(gzip)는 넣지 않음: 압축 버퍼가 SSE 이벤트를 모아 보낼 수 있어서
	reverse_proxy app:8080

	# 접속 로그는 표준 출력(docker logs caddy)으로만
	log {
		output stdout
	}
}
